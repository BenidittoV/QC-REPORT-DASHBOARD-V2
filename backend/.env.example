APP_NAME=QC Dashboard API
SECRET_KEY=ganti-dengan-random-secret-yang-panjang
SESSION_MAX_AGE_SECONDS=43200

# Untuk local:
# DATABASE_URL=sqlite:///./app.db

# Untuk Neon pooled connection:
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

CORS_ORIGINS=http://localhost:5500,https://namaprojekmu.vercel.app

STORAGE_ROOT=./storage
ADMIN_STORAGE_SUBDIR=admin
MANUAL_STORAGE_SUBDIR=manual

# Di Koyeb sebaiknya false, supaya raw Excel tidak dijadikan dependency runtime.
KEEP_UPLOADED_FILES=false

SQL_ECHO=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30

INGEST_CHUNK_SIZE=500